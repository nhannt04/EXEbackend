# Database Configuration
DATABASE_URL=jdbc:postgresql://host:5432/database?sslmode=require
DB_USERNAME=db_user
DB_PASSWORD=db_password_here

# Cloudflare R2 Configuration
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY=your_access_key
CLOUDFLARE_R2_SECRET_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=travel
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_CUSTOM_DOMAIN=https://cdn.example.com

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_with_at_least_256_bits_for_security_compliance

# Server Port (Render sets this automatically)
PORT=8080

